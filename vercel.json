{
  "version": 2,
  "name": "mamas-kitchen",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "buildCommand": "pip install -r requirements.txt",
  "env": {
    "DB_BACKEND": "postgres",
    "SUPABASE_PRODUCT_IMAGE_BUCKET": "product-images",
    "SUPABASE_DOCUMENT_BUCKET": "mamas-kitchen-documents"
  }
}
